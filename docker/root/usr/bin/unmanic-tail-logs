#!/usr/bin/env bash

unmanic_dev_logs_dir=${config_dir}/.trawlarr/logs

args="-f"
if [[ ! -z "${@}" ]]; then
    args="${args} ${@}"
fi

echo "tail ${args} /config/.trawlarr/logs/unmanic.log | grcat /.grc.conf.unmanic.logs"
tail ${args} /config/.trawlarr/logs/unmanic.log | grcat /.grc.conf.unmanic.logs
