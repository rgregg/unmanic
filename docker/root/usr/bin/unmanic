# Legacy launcher. The real one is /usr/bin/trawlarr.
#
# The image CMD is /usr/bin/trawlarr, but a compose file or systemd unit
# written against an older image may still set `command: /usr/bin/unmanic`
# or `docker exec ... unmanic`. Deleting this path would fail those with
# "no such file or directory", which is at least loud but says nothing
# useful. Forwarding silently would hide the rename from the one person who
# needs to know about it. So: forward, and say what happened.

echo "**** (unmanic) /usr/bin/unmanic is the legacy name for /usr/bin/trawlarr." >&2
echo "**** (unmanic) Forwarding. Update your command/CMD to /usr/bin/trawlarr;" >&2
echo "**** (unmanic) this wrapper will be removed in a later release." >&2

exec /usr/bin/trawlarr "${@}"
