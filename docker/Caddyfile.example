# Caddyfile.example — TLS + authentication in front of Trawlarr.
#
# Copy to ./Caddyfile, replace trawlarr.example.com and the basic_auth
# credential, then bring the stack up with docker-compose-caddy.yml.
#
# See ../docs/SECURITY_MODEL.md for why every route has to be covered.

trawlarr.example.com {
	# Authenticate the whole vhost. Not a subpath: /trawlarr/api/* is as
	# powerful as the UI (plugin upload is remote code execution), and the
	# websocket, Swagger UI, plugin panels and static assets all live under
	# the same origin. A rule scoped to /trawlarr/ui/* protects nothing.
	basic_auth * {
		# Generate the hash with:
		#   docker run --rm caddy caddy hash-password --plaintext 'your-password'
		# The value below is a placeholder and will not authenticate anything.
		trawlarr $2a$14$REPLACE.THIS.WITH.YOUR.OWN.BCRYPT.HASH.OR.NOBODY.CAN.LOG.IN
	}

	# Trawlarr is reachable only on the internal Docker network; it
	# publishes no host ports. This proxy is the only way in.
	reverse_proxy trawlarr:8888

	# Uploads (plugin zips, files added to the pending queue) can be large.
	request_body {
		max_size 2GB
	}

	encode zstd gzip

	log {
		output stdout
		format console
	}
}
